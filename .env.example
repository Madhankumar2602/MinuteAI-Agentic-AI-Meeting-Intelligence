# =============================================================================
# MinuteAI - environment template
# Copy to .env and fill in real values.  NEVER commit .env  (Rule 4)
#   cp .env.example .env
# =============================================================================

# ---- Application ----------------------------------------------------------
APP_NAME=MinuteAI
APP_ENV=development                 # development | production
APP_HOST=0.0.0.0
APP_PORT=8010                       # 8000 is taken by another local project
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | console  (console = readable dev logs)

# ---- PostgreSQL 16 + pgvector ---------------------------------------------
# These are read BOTH by docker-compose (to create the container) and by the
# backend (to build the connection URL). One source of truth.
POSTGRES_USER=minuteai
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=minuteai
POSTGRES_DB_TEST=minuteai_test      # separate DB so tests never touch dev data
POSTGRES_HOST=localhost             # 'postgres' when the API itself runs in Docker
POSTGRES_PORT=5432

# ---- DynamoDB Local --------------------------------------------------------
# boto3 refuses to run without credentials, even against DynamoDB Local.
# These values are ignored by the local emulator - any non-empty string works.
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---- Object storage: S3 (M4) ------------------------------------------------
# Locally an S3-compatible RustFS container; in AWS, real S3 with an empty
# endpoint and credentials from the IAM role (leave the keys empty there).
S3_BUCKET=minuteai-dev-media
S3_ENDPOINT_URL=http://localhost:9000
# Host used inside presigned URLs handed to browsers. Differs from S3_ENDPOINT_URL
# only when the API reaches storage through an internal hostname (e.g. Docker).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minuteai
S3_SECRET_ACCESS_KEY=change_me_locally_min_8_chars
S3_AUTO_CREATE_BUCKET=true           # false in AWS: the bucket comes from infrastructure code
MEDIA_MAX_BYTES=209715200            # 200 MB, enforced by S3 itself via the upload policy
MEDIA_UPLOAD_URL_TTL_SECONDS=900
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash

# ---- Background processing (M3) -------------------------------------------
DYNAMODB_JOBS_TABLE=minuteai_processing_jobs
DYNAMODB_AUTO_CREATE_TABLES=true     # false in AWS: tables come from infrastructure code
WORKER_EMBEDDED=true                 # false = run `python -m app.workers.processing` separately
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=30
JOB_TTL_DAYS=30

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# 5173 = Vite dev server (M5 frontend), 3000 = Create React App.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Google Gemini (LLM + transcription, from M2) -------------------------
# Get a key: https://aistudio.google.com -> Get API key -> Create API key
# Paste it after the = with no quotes and no spaces. Never commit this file.
GEMINI_API_KEY=
# Pinned, non-preview model verified against this key on 2026-09-13.
# Avoid *-latest aliases: they move, which breaks evaluation reproducibility.
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3                    # retries on 429 / 5xx / network errors
TRANSCRIPT_MAX_CHARS=400000          # ~2.5 hours of speech

# ---- Authentication --------------------------------------------------------
# Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
